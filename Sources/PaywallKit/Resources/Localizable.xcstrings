    "alert.pending.message": {
      "comment": "Purchase pending message",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is awaiting approval. You'll get access as soon as it's approved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alımınız onay bekliyor. Onaylandığında erişiminiz açılacak."
          }
        }
      }
    },
