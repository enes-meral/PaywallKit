    "button.startTrial": {
      "comment": "Purchase button when the selected plan has a free trial",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Free Trial"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz Denemeyi Başlat"
          }
        }
      }
    },
    "disclosure.autoRenew": {
      "comment": "Auto-renewable subscription disclosure (Guideline 3.1.2)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment will be charged to your Apple Account at confirmation of purchase. The subscription renews automatically unless it is cancelled at least 24 hours before the end of the current period. You can manage or cancel it in your App Store account settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme, satın alma onaylandığında Apple Hesabınızdan alınır. Abonelik, mevcut dönemin bitiminden en az 24 saat önce iptal edilmediği sürece otomatik olarak yenilenir. Aboneliğinizi App Store hesap ayarlarından yönetebilir veya iptal edebilirsiniz."
          }
        }
      }
    },
    "disclosure.oneTime": {
      "comment": "One-time purchase disclosure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time payment. This is not a subscription."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik ödeme. Bu bir abonelik değildir."
          }
        }
      }
    },
    "disclosure.trial": {
      "comment": "Free trial disclosure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't cancel at least 24 hours before the free trial ends, the subscription price will be charged automatically."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz deneme bitmeden en az 24 saat önce iptal etmezseniz abonelik ücreti otomatik olarak tahsil edilir."
          }
        }
      }
    },
