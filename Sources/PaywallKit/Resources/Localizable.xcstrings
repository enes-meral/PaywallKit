    "alert.nothingToRestore.message": {
      "comment": "Nothing to restore message",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No previous purchases were found for this Apple Account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple Hesabı için önceki bir satın alım bulunamadı."
          }
        }
      }
    },
    "alert.nothingToRestore.title": {
