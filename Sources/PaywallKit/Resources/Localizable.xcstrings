    "intro.discount": {
      "comment": "Discounted intro offer. %1$@ = intro price, %2$@ = intro duration, %3$@ = billed price after",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ for the first %2$@, then %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk %2$@ %1$@, sonra %3$@"
          }
        }
      }
    },
    "intro.freeTrial": {
      "comment": "Free trial line. %1$@ = trial duration, %2$@ = billed price after trial",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free for %1$@, then %2$@"
